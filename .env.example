# Railway Variables 예시 - 실제 값은 Railway에 직접 입력하고 GitHub에는 올리지 마세요.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ADMIN_EMAIL=your-admin-google-email@gmail.com

GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password
REPORT_RECEIVER=receiver@gmail.com

# 선택 사항: Railway URL을 고정하고 싶을 때만 사용
# PUBLIC_URL=https://workdashenhanced-production.up.railway.app
